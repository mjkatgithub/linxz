generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = "mysql://Skylight1890:4*TNPhV8iCoG*fn5w2Gp@localhost:3306/linxz"
  shadowDatabaseUrl = "mysql://Skylight1890:4*TNPhV8iCoG*fn5w2Gp@localhost:3306/linxz_shadow"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  links     Link[]
}

model Link {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
